includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    ignoreErrors:
        # Testable::mixin() rebinds each closure's `$this` to the Livewire `Testable`,
        # which static analysis cannot follow.
        -
            path: src/Testing/TestsConversations.php
            identifiers:
                - method.notFound
                - return.type
        # bacon/bacon-qr-code is suggested, not required; the class is only used when it exists.
        -
            path: src/Support/QrCode.php
            identifiers:
                - class.notFound
