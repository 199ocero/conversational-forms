{
    "name": "jaocero/conversational-forms",
    "description": "Typeform-style conversational forms for Filament. One question at a time, fully in your Laravel app.",
    "keywords": [
        "jaocero",
        "laravel",
        "livewire",
        "filamentphp",
        "filament-form",
        "filament-plugin",
        "conversational-forms",
        "typeform"
    ],
    "homepage": "https://github.com/199ocero/conversational-forms",
    "support": {
        "issues": "https://github.com/199ocero/conversational-forms/issues",
        "source": "https://github.com/199ocero/conversational-forms"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jay-Are Ocero",
            "email": "199ocero@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.1|^9.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "JaOcero\\ConversationalForms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JaOcero\\ConversationalForms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JaOcero\\ConversationalForms\\ConversationalFormsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
